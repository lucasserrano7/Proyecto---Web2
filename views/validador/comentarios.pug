extends ../layout

block contenido
  div(class="max-w-6xl w-full mx-auto p-6 my-3")
    if esAutor
      div(class="bg-white/15 backdrop-blur-md p-6 rounded-3xl shadow-xl border border-white/30 mb-4")
        h1(class="text-2xl font-black text-white") Denuncias en mis publicaciones
    else
      div(class="bg-orange-500/15 backdrop-blur-md p-6 rounded-3xl shadow-xl border border-orange-500/40 mb-4 flex flex-col md:flex-row justify-between items-center gap-4")
        h1(class="text-2xl font-black text-white flex items-center gap-2")
          | Panel de Validador
        div(class="flex gap-2 bg-white/40 p-1.5 rounded-2xl border border-white/50")
          a(href="/validador/validar" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:text-blue-900 rounded-xl transition-all")
            | Publicaciones
          a(href="/validador/comentarios" class="px-4 py-2 text-sm font-bold bg-blue-600 text-white rounded-xl shadow-md")
            | Comentarios

  div(class="max-w-5xl w-full mx-auto my-6")
    if comentarios && comentarios.length > 0
      div(class="flex flex-col gap-6")
        each c in comentarios
          - const reportes = c.denuncias || c.denuncia_comentarios || c.denunciaComentarios || []
          div(class="bg-white/5  backdrop-blur-md rounded-2xl p-6 shadow-lg border border-white/15 hover:shadow-xl transition-all flex flex-col justify-between gap-4")
            div(class="flex flex-col md:flex-row justify-between items-start gap-4 border-b border-gray-200/80 pb-4")
              div(class="flex items-center gap-3")
                div
                  p(class="font-bold text-white leading-tight") @#{c.Usuario ? c.Usuario.username : 'Usuario desconocido'}
                  p(class="text-xs text-gray-500") #{!esAutor && c.Usuario ? c.Usuario.email : ''}
              

            div(class="bg-white/15 p-4 rounded-xl border border-blue-100")
              p(class="text-xs font-semibold text-black uppercase tracking-wider mb-1") Comentario reportado:
              p(class="text-base text-white font-medium italic") "#{c.texto}"

            div(class="bg-white/15 p-4 rounded-xl border border-gray-100 space-y-2")
              p(class="text-xs font-bold text-black uppercase tracking-wider") Reportado por:
              each rep in reportes
                div(class="text-xs text-gray-700 flex flex-wrap items-center gap-2 border-b border-gray-100 last:border-0 pb-1.5")
                  span(class="font-bold text-gray-800") @#{rep.Denunciante ? rep.Denunciante.username : 'Anónimo'}:
                  span(class="bg-red-900 text-white px-2 py-0.5 rounded font-semibold") #{rep.motivo}
                  if rep.description
                    span(class="text-gray-500 italic") - "#{rep.description}"

            div(class="flex justify-end items-center gap-3 pt-2")
              form(action=`${rutaDesestimar}` || `/validador/comentarios/rechazar/${c.id}` method="POST" onsubmit="return confirm('¿Desestimar las denuncias de este comentario?')")
                button(type="submit" class="px-4 py-2 bg-green-600/50 hover:bg-green-700/70 text-white font-semibold rounded-xl text-sm transition-all flex items-center gap-2 cursor-pointer")
                  | Desestimar

              form(action=`${rutaBaja}` || `/validador/comentarios/baja/${c.id}` method="POST" onsubmit="return confirm('¿Confirmás dar de baja este comentario infractor?')")
                button(type="submit" class="px-4 py-2 bg-red-600/50 hover:bg-red-600/70 text-white font-semibold rounded-xl text-sm transition-all shadow-md hover:shadow-lg flex items-center gap-2 cursor-pointer")
                  | Dar de baja
    else
      div(class="p-6 text-center border-2 border border-white/20 rounded-2xl bg-white/5")
        p(class="text-sm font-bold text-white/70") No hay comentarios denunciados