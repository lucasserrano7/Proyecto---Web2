extends ../layout

block contenido
  div(class="max-w-5xl w-full mx-auto p-6 my-6")
    div(class="bg-white/70 backdrop-blur-md p-6 rounded-3xl shadow-xl border border-white/40 mb-8 flex flex-col md:flex-row justify-between items-center gap-4")
      div
        h1(class="text-2xl font-black text-blue-950 flex items-center gap-2")
          i(class="fa-solid fa-shield-halved text-blue-600")
          | Panel de Moderación: Comentarios
        p(class="text-sm text-gray-600 mt-1") Revisá los reportes de la comunidad y decidí qué acciones tomar.

      div(class="flex gap-2 bg-white/40 p-1.5 rounded-2xl border border-white/50")
        a(href="/validador/validar" class="px-4 py-1.5 text-sm font-semibold text-gray-600 hover:text-blue-900 rounded-xl transition-all")
          i(class="fa-solid fa-image mr-1.5")
          | Publicaciones
        a(href="/validador/comentarios" class="px-4 py-1.5 text-sm font-bold bg-blue-600 text-white rounded-xl shadow-md")
          i(class="fa-solid fa-comments mr-1.5")
          | Comentarios (#{comentarios ? comentarios.length : 0})

    if comentarios && comentarios.length > 0
      div(class="flex flex-col gap-6")
        each c in comentarios
          - const reportes = c.denuncia_comentarios || c.denunciaComentarios || []
          div(class="bg-white/80 backdrop-blur-md rounded-2xl p-6 shadow-lg border border-white/60 hover:shadow-xl transition-all flex flex-col justify-between gap-4")
            div(class="flex flex-col md:flex-row justify-between items-start gap-4 border-b border-gray-200/80 pb-4")
              div(class="flex items-center gap-3")
                div(class="w-11 h-11 rounded-full bg-blue-100 border border-blue-300 flex items-center justify-center text-blue-600 font-bold text-lg shadow-inner")
                  if c.Usuario && c.Usuario.username
                    | #{c.Usuario.username.charAt(0).toUpperCase()}
                  else
                    | ?
                div
                  p(class="font-bold text-gray-900 leading-tight") @#{c.Usuario ? c.Usuario.username : 'Usuario desconocido'}
                  p(class="text-xs text-gray-500") #{c.Usuario ? c.Usuario.email : ''}
              
              span(class="text-xs bg-red-100 text-red-700 px-3 py-1 rounded-full font-bold border border-red-200 flex items-center gap-1 self-start")
                i(class="fa-solid fa-triangle-exclamation text-xs")
                | #{reportes.length} #{reportes.length === 1 ? 'denuncia' : 'denuncias'}

            div(class="bg-blue-50/60 p-4 rounded-xl border border-blue-100")
              p(class="text-xs font-semibold text-blue-800 uppercase tracking-wider mb-1") Contenido reportado:
              p(class="text-base text-gray-800 font-medium italic") "#{c.texto}"

            div(class="bg-white/50 p-4 rounded-xl border border-gray-100 space-y-2")
              p(class="text-xs font-bold text-gray-500 uppercase tracking-wider") Reportado por:
              each rep in reportes
                div(class="text-xs text-gray-700 flex flex-wrap items-center gap-2 border-b border-gray-100 last:border-0 pb-1.5")
                  span(class="font-bold text-gray-800") @#{rep.Denunciante ? rep.Denunciante.username : 'Anónimo'}:
                  span(class="bg-red-500/10 text-red-600 px-2 py-0.5 rounded font-semibold") #{rep.motivo}
                  if rep.description
                    span(class="text-gray-500 italic") - "#{rep.description}"

            div(class="flex justify-end items-center gap-3 pt-2")
              form(action=`/validador/comentarios/rechazar/${c.id}` method="POST" onsubmit="return confirm('¿Desestimar las denuncias de este comentario?')")
                button(type="submit" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-xl text-sm transition-all flex items-center gap-2 cursor-pointer")
                  i(class="fa-solid fa-check text-green-600")
                  | Desestimar

              form(action=`/validador/comentarios/baja/${c.id}` method="POST" onsubmit="return confirm('¿Confirmás dar de baja este comentario infractor?')")
                button(type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-sm transition-all shadow-md hover:shadow-lg flex items-center gap-2 cursor-pointer")
                  i(class="fa-solid fa-trash")
                  | Dar de baja
    else
      div(class="bg-white/70 backdrop-blur-md rounded-3xl p-12 text-center shadow-lg border border-white/40 max-w-md mx-auto my-12")
        div(class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner")
          i(class="fa-solid fa-check-double")
        h3(class="text-xl font-bold text-gray-800 mb-1") ¡Bandeja limpia!
        p(class="text-sm text-gray-600") No hay comentarios denunciados pendientes de revisión por el momento.