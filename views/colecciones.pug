extends layout 

block metadata 
  title Colecciones
  link(rel="stylesheet", href="/css/style.css")
  script(src="https://unpkg.com/@tailwindcss/browser@4")
  link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_circle_up")

block contenido 
  div(class="max-w-7xl mx-auto px-6 py-8")
    div(class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 bg-white/10 backdrop-blur-md border border-white/30 rounded-2xl p-6 shadow-lg text-white")
      div
        h1(class="text-3xl font-black tracking-tight drop-shadow-sm") Mis Colecciones
        p(class="text-xs text-white/70 font-medium mt-1") Agrupá y ordená tus fotos favoritas.
      
      button#btn-abrir-modal-coleccion(type="button" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider py-3 px-5 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 cursor-pointer")
        i(class="fa-solid fa-folder-plus text-sm")
        | Nueva Colección

    if colecciones && colecciones.length > 0
      div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6")
        each col in colecciones
          a(href=`/colecciones/${col.id}` class="group relative rounded-3xl bg-white/15 backdrop-blur-md border border-white/30 shadow-xl overflow-hidden flex flex-col transition-all duration-300 hover:scale-[1.02] hover:bg-white/25")
            div(class="h-44 w-full bg-slate-900/30 overflow-hidden relative flex items-center justify-center")
              if col.publicacions && col.publicacions.length > 0 && col.publicacions[0].Imagens && col.publicacions[0].Imagens.length > 0
                img(src=col.publicacions[0].Imagens[0].url alt=col.titulo class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105")
              else
                div(class="text-white/40 flex flex-col items-center gap-2")
                  i(class="fa-regular fa-image text-3xl")
                  span(class="text-[10px] font-bold uppercase tracking-wider") Sin fotos aún
              
              div(class="absolute top-3 right-3 bg-black/40 backdrop-blur-xs px-2.5 py-1 rounded-full border border-white/20 text-white text-[10px] font-bold flex items-center gap-1.5")
                if col.publico
                  i(class="fa-solid fa-globe text-emerald-400 text-[9px]")
                  | Público
                else
                  i(class="fa-solid fa-lock text-amber-400 text-[9px]")
                  | Privado

            div(class="p-5 flex flex-col justify-between flex-1 text-white")
              div
                span(class="text-[10px] font-bold uppercase tracking-wider bg-white/15 px-2 py-0.5 rounded-md border border-white/20")= col.categoria
                h3(class="text-lg font-black tracking-tight mt-2 drop-shadow-xs truncate")= col.titulo
              
              div(class="flex items-center justify-between mt-4 pt-3 border-t border-white/10 text-white/60 text-xs font-semibold")
                span Ver álbum
                i(class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1")
    else
      div(class="bg-white/10 backdrop-blur-md rounded-3xl border border-white/30 p-12 text-center max-w-md mx-auto shadow-xl text-white")
        i(class="fa-solid fa-folder-open text-4xl mb-3 text-white/60")
        h3(class="text-lg font-bold mb-1") No tenés colecciones todavía
        p(class="text-xs text-white/70 mb-4") Creá una para empezar a guardar tus fotos.
        button(type="button" onclick="document.getElementById('btn-abrir-modal-coleccion').click()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider py-2.5 px-5 rounded-xl shadow-md transition-all active:scale-95 cursor-pointer")
          | Crear Colección

    div#modal-crear-coleccion(class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center z-50 p-4")
      div(class="bg-white/95 backdrop-blur-md border border-white/70 p-6 rounded-3xl max-w-md w-full shadow-2xl")
        h4(class="text-lg font-black text-blue-950 mb-4 flex items-center gap-2")
          i(class="fa-solid fa-folder-plus text-blue-600")
          | Nueva Colección
        
        form#form-crear-coleccion(class="flex flex-col gap-4")
          div
            label(class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5") Título de la colección:
            input(type="text" name="titulo" required placeholder="Ej: Paisajes de Viaje" class="w-full p-2.5 rounded-xl bg-white border border-gray-200 text-xs font-semibold text-gray-800 outline-none focus:border-blue-500 shadow-xs")
          
          div
            label(class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5") Categoría:
            select(name="categoria" required class="w-full p-2.5 rounded-xl bg-white border border-gray-200 text-xs font-semibold text-gray-800 outline-none focus:border-blue-500 shadow-xs")
              option(value="") Seleccioná una categoría
              option(value="Fotografía Urbana") Fotografía Urbana
              option(value="Naturaleza") Naturaleza
              option(value="Retratos") Retratos
              option(value="Minimalismo") Minimalismo
              option(value="Otro") Otro

          div
            label(class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5") Visibilidad:
            select(name="publico" class="w-full p-2.5 rounded-xl bg-white border border-gray-200 text-xs font-semibold text-gray-800 outline-none focus:border-blue-500 shadow-xs")
              option(value="true") Pública (visible para toda la comunidad)
              option(value="false") Privada (solo vos podés verla)

          div(class="flex justify-end gap-2 mt-2")
            button#btn-cancelar-modal-col(type="button" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl text-xs uppercase tracking-wider transition-all cursor-pointer") Cancelar
            button(type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer") Guardar Álbum

  script.
    const modalCol = document.getElementById("modal-crear-coleccion");
    const btnAbrirCol = document.getElementById("btn-abrir-modal-coleccion");
    const btnCancelarCol = document.getElementById("btn-cancelar-modal-col");
    const formCol = document.getElementById("form-crear-coleccion");

    if (btnAbrirCol && modalCol) {
      btnAbrirCol.addEventListener("click", () => {
        modalCol.classList.remove("hidden");
        modalCol.classList.add("flex");
      });
    }

    if (btnCancelarCol && modalCol) {
      btnCancelarCol.addEventListener("click", () => {
        modalCol.classList.add("hidden");
        modalCol.classList.remove("flex");
      });
    }

    if (formCol) {
      formCol.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(formCol);
        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch("/colecciones/crear", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify(data)
          });

          const resData = await res.json();
          if (res.ok && resData.success) {
            if (window.mostrarAlerta) mostrarAlerta(resData.message, "success");
            setTimeout(() => window.location.reload(), 800);
          } else {
            if (window.mostrarAlerta) mostrarAlerta(resData.message || "Error al crear", "warning");
          }
        } catch (err) {
          console.error(err);
          if (window.mostrarAlerta) mostrarAlerta("Error de conexión al crear colección", "error");
        }
      });
    }