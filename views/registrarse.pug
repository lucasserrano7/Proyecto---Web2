extends layout 

block metadata 
  script(src="https://cdn.tailwindcss.com")
  link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200")

block contenido
  style. 
    body {
      background-image: url('/img/WinHS (1).jpg');
      background-size: cover;
      background-position: center;          
      background-attachment: fixed;
      background-repeat: no-repeat;
    }

  div(class="min-h-[85vh] flex items-center justify-center px-4 py-10")
    form#form(action='/registro' method='POST' autocomplete='off' class='flex flex-col gap-4 w-full max-w-md p-8 sm:p-10 bg-blue-950/30 backdrop-blur-xl border border-white/30 rounded-3xl shadow-2xl')
      
      h3(class='text-2xl font-black text-white text-center tracking-wide pb-2 uppercase drop-shadow-sm') Crear una cuenta 
      
      div(class='relative mb-2')
        input#usuario(type='text' name='usuario' required="true" class='border-white/40 border-2 rounded-xl px-3 py-2.5 text-white peer w-full bg-white/10 outline-none focus:border-white focus:bg-white/20 transition-all text-sm')
        label(for='usuario' class='text-sm absolute left-3 top-2.5 text-white/70 transition-all pointer-events-none peer-focus:-top-2.5 peer-focus:text-xs peer-focus:bg-blue-900/90 peer-focus:px-2 peer-focus:rounded-md peer-focus:text-white peer-valid:-top-2.5 peer-valid:text-xs peer-valid:bg-blue-900/90 peer-valid:px-2 peer-valid:rounded-md peer-valid:text-white') Usuario

      div(class='relative mb-2')
        input#email(type='email' name='email' required="true" class='border-white/40 border-2 rounded-xl px-3 py-2.5 text-white peer w-full bg-white/10 outline-none focus:border-white focus:bg-white/20 transition-all text-sm')
        label(for='email' class='text-sm absolute left-3 top-2.5 text-white/70 transition-all pointer-events-none peer-focus:-top-2.5 peer-focus:text-xs peer-focus:bg-blue-900/90 peer-focus:px-2 peer-focus:rounded-md peer-focus:text-white peer-valid:-top-2.5 peer-valid:text-xs peer-valid:bg-blue-900/90 peer-valid:px-2 peer-valid:rounded-md peer-valid:text-white') Email

      div(class='relative mb-2')
        input#contrasenia(type='password' name='contrasenia' required="true" class='border-white/40 border-2 rounded-xl pl-3 pr-10 py-2.5 text-white peer w-full bg-white/10 outline-none focus:border-white focus:bg-white/20 transition-all text-sm')
        label(for='contrasenia' class='text-sm absolute left-3 top-2.5 text-white/70 transition-all pointer-events-none peer-focus:-top-2.5 peer-focus:text-xs peer-focus:bg-blue-900/90 peer-focus:px-2 peer-focus:rounded-md peer-focus:text-white peer-valid:-top-2.5 peer-valid:text-xs peer-valid:bg-blue-900/90 peer-valid:px-2 peer-valid:rounded-md peer-valid:text-white') Contraseña
        button(type='button' onclick="verContrasenia('contrasenia', 'ojo1')" class='text-white absolute right-3 top-1/2 -translate-y-1/2 opacity-70 hover:opacity-100 transition-opacity cursor-pointer flex items-center justify-center')
          span#ojo1.material-symbols-outlined(class='text-xl') visibility_off

      div(class='relative mb-2')
        input#repetir(type='password' name='repetir' required="true" class='border-white/40 border-2 rounded-xl pl-3 pr-10 py-2.5 text-white peer w-full bg-white/10 outline-none focus:border-white focus:bg-white/20 transition-all text-sm')
        label(for='repetir' class='text-sm absolute left-3 top-2.5 text-white/70 transition-all pointer-events-none peer-focus:-top-2.5 peer-focus:text-xs peer-focus:bg-blue-900/90 peer-focus:px-2 peer-focus:rounded-md peer-focus:text-white peer-valid:-top-2.5 peer-valid:text-xs peer-valid:bg-blue-900/90 peer-valid:px-2 peer-valid:rounded-md peer-valid:text-white') Repetir contraseña
        button(type='button' onclick="verContrasenia('repetir', 'ojo2')" class='text-white absolute right-3 top-1/2 -translate-y-1/2 opacity-70 hover:opacity-100 transition-opacity cursor-pointer flex items-center justify-center')
          span#ojo2.material-symbols-outlined(class='text-xl') visibility_off

      div(class='flex flex-col gap-2 my-1 text-xs text-white')
        div(class='flex items-center gap-2')
          input#tyc(type='checkbox' name='terminos' required="true" class='w-4 h-4 cursor-pointer accent-blue-600 rounded')
          label(for='tyc' class='cursor-pointer text-white/90') Acepto los 
            a(href='/T&C' class='text-blue-300 font-bold underline hover:text-white ml-1') Términos y Condiciones
        div(class='flex items-center gap-2')
          input#ofertas(type='checkbox' name='ofertas' class='w-4 h-4 cursor-pointer accent-blue-600 rounded')
          label(for='ofertas' class='cursor-pointer text-white/90') Recibir ofertas y novedades

      input#enviar(type='submit' value='REGISTRARSE' class='w-full cursor-pointer mt-2 border border-white/40 rounded-xl py-3 text-white bg-blue-600/80 hover:bg-blue-600 backdrop-blur-md transition-all text-sm font-black tracking-wider shadow-lg active:scale-95')
      
      div#mensajes(class='mt-2 text-center text-xs text-white border border-red-500/50 bg-red-600/40 backdrop-blur-md p-3 rounded-xl font-bold empty:hidden shadow-lg')

  script.
    const mensajes = document.querySelector("#mensajes");
    const enviar = document.querySelector("#enviar");
    const campoEmail = document.querySelector("#email");
    const campoUsuario = document.querySelector("#usuario");
    const terminosycondiciones = document.querySelector("#tyc");
    const form = document.querySelector("#form");

    let emailValido = false;
    let userValido = false;
    let terYcond = false;

    const emailRE = /^[a-zA-Z0-9._%-]+@gmail\.com$/;

    async function revisarEmail() {
      const anterior = document.querySelector("#mensajeEmail");
      if(anterior) anterior.remove(); 
      
      const valor = campoEmail.value;
      const res = await fetch(`/revisarEmail?email=${valor}`);
      const data = await res.json();

      const emailMsg = document.createElement("p");
      emailMsg.id = "mensajeEmail";
      mensajes.appendChild(emailMsg);

      if(!emailRE.test(valor)){
        emailMsg.innerHTML = "Formato de email incorrecto (debe ser @gmail.com)";
        emailValido = false;
        temporizadorErr();
        return false;
      }
      
      if(data.respuesta) {                  
        emailMsg.innerHTML = "El Email ingresado ya está en uso, intente uno distinto";
        emailValido = false;
        temporizadorErr();
        return false;
      } else {
        emailMsg.remove();
        emailValido = true;
        return true;
      }
    }

    async function revisarUsuario() {
      const anterior = document.querySelector("#mensajeUsuario");
      if(anterior) anterior.remove();
      
      const valor = campoUsuario.value;
      if(!valor) {
        userValido = false;
        return false;
      }

      const res = await fetch(`/revisarUsuario?usuario=${valor}`);
      const data = await res.json();

      const usuarioMsg = document.createElement("p");
      usuarioMsg.id = "mensajeUsuario";
      mensajes.appendChild(usuarioMsg);

      if(data.respuesta) {                  
        usuarioMsg.innerHTML = "El Usuario ingresado ya está en uso, intente uno distinto";
        userValido = false;
        temporizadorErr();
        return false;
      } else {
        usuarioMsg.remove();
        userValido = true;
        return true;
      }
    }

    function revisarTyC() {
      const anterior = document.querySelector("#MensajeTyC");
      if (anterior) anterior.remove();
      
      const tycMsg = document.createElement("p"); 
      tycMsg.id = "MensajeTyC";
      mensajes.appendChild(tycMsg);

      if(terminosycondiciones.checked){
        tycMsg.remove();
        terYcond = true;
        return true;
      } else {
        tycMsg.innerHTML = "Tienes que aceptar los Términos y Condiciones";
        terYcond = false;
        temporizadorErr();
        return false;
      }
    }

    function verSiLasContraseniasSonIguales(){
      const contraseniaInput = document.querySelector("#contrasenia");   
      const repetirInput = document.querySelector("#repetir");       
      const anterior = document.querySelector("#ContrasMensaje");
      if(anterior) anterior.remove();

      const contrasMsg = document.createElement("p");
      contrasMsg.id = "ContrasMensaje";
      mensajes.appendChild(contrasMsg);

      if(contraseniaInput.value.length <= 7){ 
        contrasMsg.innerHTML = "La contraseña es demasiado corta (mínimo 8 caracteres)"; 
        temporizadorErr();
        return false;
      }
      if(contraseniaInput.value === repetirInput.value){ 
        contrasMsg.remove();
        return true;       
      } else {
        contrasMsg.innerHTML = "Las contraseñas son distintas";
        temporizadorErr();
        return false;
      }
    }

    function verContrasenia(inputId, iconoId){
      const input = document.getElementById(inputId);
      const icono = document.getElementById(iconoId);
      if (input.type === 'password'){
        input.type = 'text';
        icono.innerText = 'visibility';
      }else{
        input.type = 'password';
        icono.innerText = 'visibility_off';
      }
    }

    function temporizadorErr(){
      setTimeout(()=>{
        mensajes.innerHTML = "";
      }, 4000);
    }

    campoEmail.addEventListener('blur', revisarEmail);
    campoUsuario.addEventListener('blur', revisarUsuario);
    terminosycondiciones.addEventListener('change', revisarTyC);
    
    const campoContrasenia = document.querySelector("#contrasenia");
    const campoRepetir = document.querySelector("#repetir");
    campoContrasenia.addEventListener('blur', verSiLasContraseniasSonIguales);
    campoRepetir.addEventListener('blur', verSiLasContraseniasSonIguales);

    form.addEventListener('submit', async (event) => { 
      event.preventDefault(); 

      const emailOk = await revisarEmail();
      const usuarioOk = await revisarUsuario();
      const tycOk = revisarTyC();
      const contraOk = verSiLasContraseniasSonIguales();

      if(emailOk && usuarioOk && tycOk && contraOk){ 
        const email = campoEmail.value;
        const usuario = campoUsuario.value;
        const contrasenia = campoContrasenia.value;
        const ofertas = document.querySelector("#ofertas").checked ? "on" : "off";

        try {
          const respuesta = await fetch('/registro', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, usuario, contrasenia, ofertas })
          });
          const data = await respuesta.json();
          
          if(!data.success){
            const errorMsg = document.createElement("p");
            errorMsg.innerHTML = data.error;
            mensajes.appendChild(errorMsg);
            temporizadorErr();
          } else {
            window.location.href = '/login';
          }
        } catch(err){
          console.error('Error en el registro', err);
        }
      } else {
        temporizadorErr();
      }
    });