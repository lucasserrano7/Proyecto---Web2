block metadata 
  script(src="https://cdn.tailwindcss.com")

block contenido
  div#bg_subir(class="fixed inset-0 backdrop-blur-md z-50 flex items-center justify-center p-4 bg-slate-950/70 hidden transition-all duration-300")

    div(class="relative w-full max-w-2xl bg-white/10 backdrop-blur-2xl border border-white/20 rounded-3xl shadow-2xl p-6 sm:p-8 max-h-[92vh] overflow-y-auto text-white")

      button#btn_cerrar(type="button" class="absolute top-5 right-5 text-white/70 hover:text-white hover:bg-white/20 rounded-2xl w-9 h-9 flex items-center justify-center transition-all cursor-pointer border border-white/20 active:scale-90")
        i(class="fa-solid fa-xmark text-sm")

      div(class="mb-6 flex items-center gap-3")
       div
          h3(class="text-xl font-black tracking-tight drop-shadow-sm") Nueva Publicación
          p(class="text-xs text-white/60 font-medium") Compartí tu fotografía con la comunidad de Fotaza

      form#form_publi(action="/p" method="POST" autocomplete="off" class="flex flex-col gap-4")

        div(class="flex flex-col gap-1.5")
          label(class="text-[11px] font-black uppercase tracking-wider text-white/80") Título
          input(
            type="text" 
            name="title" 
            placeholder="Dale un título a tu foto..." 
            class="w-full bg-white/10 border border-white/20 rounded-2xl px-4 py-2.5 text-sm text-white placeholder-white/40 outline-none focus:border-blue-400 focus:bg-white/15 transition-all shadow-inner"
          )

        div(class="flex flex-col gap-1.5")
          label(class="text-[11px] font-black uppercase tracking-wider text-white/80") Descripción
          textarea(
            name="descripcion" 
            rows="3"
            placeholder="Contá la historia detrás del disparo, cámara o técnica utilizada..." 
            class="w-full bg-white/10 border border-white/20 rounded-2xl px-4 py-2.5 text-sm text-white placeholder-white/40 outline-none focus:border-blue-400 focus:bg-white/15 transition-all resize-none shadow-inner"
          )

        div(class="flex flex-col gap-1.5")
          label(class="text-[11px] font-black uppercase tracking-wider text-white/80 flex items-center justify-between")
            span Etiquetas
            span(class="text-[10px] text-white/50 normal-case font-medium") Separadas por comas
          div(class="relative")
            span(class="absolute left-4 top-2.5 text-blue-300 font-bold text-sm") #
            input(
              type="text" 
              name="etiquetas" 
              placeholder="naturaleza, retrato, atardecer" 
              class="w-full bg-white/10 border border-white/20 rounded-2xl pl-8 pr-4 py-2.5 text-sm text-white placeholder-white/40 outline-none focus:border-blue-400 focus:bg-white/15 transition-all shadow-inner"
            )

        div(class="grid grid-cols-1 sm:grid-cols-2 gap-3 py-1")
          label(class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-2xl border border-white/15 cursor-pointer transition-all shadow-sm")
            input(type="checkbox" name="comentarios" checked class="w-4 h-4 rounded-md accent-blue-600 bg-white/20 border-white/30 cursor-pointer")
            div(class="text-xs")
              span(class="font-bold block text-white") Permitir comentarios
              span(class="text-[10px] text-white/60") Deja que opinen de tu foto

          label(class="flex items-center gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-2xl border border-white/15 cursor-pointer transition-all shadow-sm")
            input(type="checkbox" id="tieneCopy" name="tieneCopy" class="w-4 h-4 rounded-md accent-blue-600 bg-white/20 border-white/30 cursor-pointer")
            div(class="text-xs")
              span(class="font-bold block text-white") Marca de agua
              span(class="text-[10px] text-white/60") Protege los derechos de autor

        div#divMarcaAgua(class="flex flex-col gap-1.5 transition-all")
          label(class="text-[11px] font-black uppercase tracking-wider text-white/80") Texto de Marca de Agua
          input(
            type="text" 
            id="textoMarcaAgua" 
            name="textoMarcaAgua" 
            disabled 
            placeholder="Ej: @TuUsuario o © Tu Nombre" 
            class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-2.5 text-sm text-white placeholder-white/30 outline-none focus:border-blue-400 transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-inner"
          )

        div(class="flex flex-col gap-2 pt-2")
          label(
            for="img" 
            class="w-full flex flex-col items-center justify-center p-5 rounded-2xl border-2 border-dashed border-white/30 bg-white/5 hover:bg-white/10 hover:border-blue-400 transition-all cursor-pointer group shadow-sm text-center"
          )
            i(class="fa-solid fa-images text-2xl text-white/60 group-hover:text-blue-300 group-hover:scale-110 transition-all mb-2")
            span(class="text-xs font-bold uppercase tracking-wider text-white") Seleccionar fotografías
            span(class="text-[11px] text-white/50 mt-0.5") Podés elegir una o varias imágenes

          input#img(type="file" name="img" multiple hidden)
          
          div#container_preview(class="flex flex-wrap gap-3 mt-1 empty:hidden")
            img#preview(src="" alt="preview" class="hidden")
            textarea#imgBase64(name="imgBase64" hidden)

        input#subir(
          type="submit" 
          value="Publicar Fotografía" 
          class="w-full cursor-pointer bg-blue-600 hover:bg-blue-500 border border-white/30 text-white font-black py-3 rounded-2xl transition-all text-sm uppercase tracking-wider shadow-lg active:scale-98 mt-3"
        )

  script.
    const fileInput = document.getElementById('img');
    const previewContainer = document.getElementById('container_preview');
    const formularioPubli = document.getElementById('form_publi');
    const arregloImg = [];

    fileInput.addEventListener('change', (e) => {
      const archivos = e.target.files;
      for (let i = 0; i < archivos.length; i++) {
        const archivo = archivos[i];
        const reader = new FileReader();

        reader.onload = () => {
          arregloImg.push({ src: reader.result, name: archivo.name });

          const divWrapper = document.createElement('div');
          divWrapper.className = 'relative inline-block w-24 h-24 rounded-2xl overflow-hidden border border-white/40 shadow-md group';
          divWrapper.dataset.name = archivo.name;

          const imgNode = document.createElement('img');
          imgNode.src = reader.result;
          imgNode.className = 'w-full h-full object-cover';

          const btnDelete = document.createElement('button');
          btnDelete.type = 'button';
          btnDelete.innerHTML = '<i class="fa-solid fa-xmark text-[10px]"></i>';
          btnDelete.className = 'absolute top-1.5 right-1.5 bg-red-500/80 hover:bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center shadow-md cursor-pointer transition-all border border-white/40';
          btnDelete.onclick = () => {
            const index = arregloImg.findIndex(img => img.name === archivo.name);
            if (index !== -1) arregloImg.splice(index, 1);
            divWrapper.remove();
          };

          divWrapper.appendChild(imgNode);
          divWrapper.appendChild(btnDelete);
          previewContainer.appendChild(divWrapper);
        };
        reader.readAsDataURL(archivo);
      }
      fileInput.value = '';
    });

    document.addEventListener('DOMContentLoaded', () => {
      const checkCpy = document.getElementById('tieneCopy');
      const inputMarcaAgua = document.getElementById('textoMarcaAgua');

      checkCpy.addEventListener('change', (e) => {
        if (e.target.checked) {
          inputMarcaAgua.disabled = false;
          inputMarcaAgua.classList.remove('bg-white/5', 'border-white/10');
          inputMarcaAgua.classList.add('bg-white/10', 'border-white/20');
          inputMarcaAgua.focus();
        } else {
          inputMarcaAgua.disabled = true;
          inputMarcaAgua.value = '';
          inputMarcaAgua.classList.remove('bg-white/10', 'border-white/20');
          inputMarcaAgua.classList.add('bg-white/5', 'border-white/10');
        }
      });
    });

    formularioPubli.addEventListener('submit', (e) => {
      e.preventDefault();
      const inputTitle = formularioPubli.querySelector('[name="title"]');
      const labelImg = formularioPubli.querySelector('label[for="img"]');

      inputTitle.classList.remove('border-red-500', 'ring-2', 'ring-red-400');
      labelImg.classList.remove('border-red-500', 'bg-red-500/20');

      const formdata = new FormData(formularioPubli);
      const txtTitle = formdata.get('title') ? formdata.get('title').trim() : '';
      const txtDesc = formdata.get('descripcion') ? formdata.get('descripcion').trim() : '';
      const checked = formdata.get('comentarios') === 'on';
      const tieneCopy = formdata.get('tieneCopy') === 'on';
      const txtMarcaAgua = formdata.get('textoMarcaAgua') ? formdata.get('textoMarcaAgua').trim() : '';

      let tieneError = false;
      if (!txtTitle) {
        inputTitle.classList.add('border-red-500', 'ring-2', 'ring-red-400');
        tieneError = true;
      }
      if (arregloImg.length === 0) {
        labelImg.classList.add('border-red-500', 'bg-red-500/20');
        tieneError = true;
      }
      if (tieneError) return;

      const etiquetasInput = formdata.get('etiquetas');
      const arrayEtiquetas = etiquetasInput
        ? etiquetasInput.split(',').map(e => e.trim().toLowerCase()).filter(e => e !== '')
        : [];

      const bodtoSend = {
        title: txtTitle,
        descripcion: txtDesc,
        comments_allowed: checked,
        tieneCopy: tieneCopy,
        textoMarcaAgua: txtMarcaAgua,
        img: arregloImg,
        etiquetas: arrayEtiquetas,
        fech: new Date().toLocaleTimeString(),
      };

      fetch(formularioPubli.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(bodtoSend)
      })
      .then(response => {
        if (response.ok) {
          window.location.href = '/index?subido=true';
        } else {
          alert('Ocurrió un error al procesar la publicación.');
        }
      })
      .catch(err => console.error('Error general:', err));
    });