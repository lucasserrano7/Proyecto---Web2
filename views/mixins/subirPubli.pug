    script. 
        console.log("Script de imágenes cargado correctamente");
        const fileInput = document.getElementById('img');
        const previewContainer = document.getElementById('container_preview');
        const formularioPubli = document.getElementById('form_publi');
        const form = document.forms[0];

        const arregloImg = [];
        console.log("Elementos capturados:", { fileInput, previewContainer, formularioPubli });

        fileInput.addEventListener('change', (e) =>{
            console.log("Seleccionaste imágenes nuevas");
            const archivos = e.target.files;

            for (let i = 0 ; i < archivos.length; i++){
                const archivo= archivos[i];

                const reader = new FileReader();
                reader.onload = () => {
                    const imagen = {
                        src: reader.result,
                        name: archivo.name
                    }
                arregloImg.push(imagen);
                console.log(" Imagen agregada al array. Total:", arregloImg.length);

                const divWrapper = document.createElement('div');
                divWrapper.className = 'relative inline-block mt-4';

                divWrapper.dataset.name = archivo.name;

                const imgNode = document.createElement('img');
                imgNode.src = reader.result;
                imgNode.className = 'w-32 max-h-32 object-cover rounded-lg border-2 border-white/30 shadow-lg';


                const btnDelete = document.createElement('button');
                btnDelete.type = 'button';
                btnDelete.innerHTML = '✕';
                btnDelete.className = 'absolute -top-2 -right-2 bg-white/40 text-red-500 hover:text-white hover:font-bold text-xl cursor-pointer z-10 hover:bg-red-500  rounded-full w-6 h-6 flex items-center justify-center font-bold shadow-md cursor-pointer transition-colors';
                btnDelete.onclick = () => {
                    const index = arregloImg.findIndex(img => img.name === archivo.name);
                    if (index !== -1){
                        arregloImg.splice(index, 1);
                        console.log("Imagen borrada. Quedan:", arregloImg.length);
                    }
                        divWrapper.remove();
                    };

                divWrapper.appendChild(imgNode);
                divWrapper.appendChild(btnDelete);

                previewContainer.appendChild(divWrapper);
            };

                reader.readAsDataURL(archivo);
            }
            fileInput.value = '';
        });

        document.addEventListener('DOMContentLoaded',()=>{
            const checkCpy = document.getElementById('tieneCopy');
            const inputMarcaAgua = document.getElementById('textoMarcaAgua');

            checkCpy.addEventListener('change',(e)=>{
              if(e.target.checked){
                inputMarcaAgua.disabled = false;
                inputMarcaAgua.focus();
              } else{
                inputMarcaAgua.disabled = true;
                inputMarcaAgua.value = '';
              } 
            });

        });


        formularioPubli.addEventListener('submit', (e) => {
            e.preventDefault();
            console.log("Iniciando validacion de titulo y fotos...");

            const inputTitle = formularioPubli.querySelector('[name="title"]');
            const labelImg = formularioPubli.querySelector('label[for="img"]');

            inputTitle.classList.remove('border-red-500', 'focus:border-red-500');
            inputTitle.classList.add('border-white/50', 'focus:border-white');

            labelImg.classList.remove('border-red-500', 'border-2', 'bg-red-500/20');
            labelImg.classList.add('bg-white/10');

            
            const formdata = new FormData(formularioPubli);
            const txtTitle = formdata.get('title') ? formdata.get('title').trim() : '';
            const txtDesc = formdata.get('descripcion') ? formdata.get('descripcion').trim() : '';
            const checked = formdata.get('comentarios') === 'on';
            const tieneCopy = formdata.get('tieneCopy') === 'on';
            const txtMarcaAgua = formdata.get('textoMarcaAgua') ? formdata.get('textoMarcaAgua').trim() : '';

            let tieneError = false;

            if (!txtTitle) {
                inputTitle.classList.remove('border-white/50', 'focus:border-white');
                inputTitle.classList.add('border-red-500', 'focus:border-red-500');
                tieneError = true;
            }

            if (arregloImg.length === 0) {
                labelImg.classList.remove('bg-white/10');
                labelImg.classList.add('border-2', 'border-red-500', 'bg-red-500/20');
                tieneError = true;
            }

            if (tieneError) {
                console.log("Envio cancelado: Faltan campos obligatorios");
                return;
            }

            const etiquetasInput = formdata.get('etiquetas');
            const arrayEtiquetas = etiquetasInput ? etiquetasInput.split(',').map(e => e.trim().toLowerCase()).filter(e => e !== '') : [];

            const bodtoSend = {
                title: txtTitle,
                descripcion: txtDesc,
                comments_allowed: checked,
                tieneCopy: tieneCopy,
                textoMarcaAgua: txtMarcaAgua,
                img: arregloImg,
                etiquetas: arrayEtiquetas,
                fech: new Date().toLocaleTimeString(),
            };

            console.log("Paquete listo y validado. Enviando:", bodtoSend);

            fetch(formularioPubli.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'same-origin',
                body: JSON.stringify(bodtoSend)
            })
            .then(response => {
                console.log("Respuesta del servidor:", response.status);
                if (response.ok) {
                    window.location.href = '/index?subido=true';
                } else {
                    console.error('Error al enviar publicacion en el servidor');
                }
            })
            .catch(err => console.error('Error general:', err));
        });