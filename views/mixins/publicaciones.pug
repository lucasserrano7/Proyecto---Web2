mixin publicaciones(usuario)
    main(class='mx-auto p-4')
        if publicaciones && publicaciones.length > 0
            div(class='flex flex-col gap-8 m-7')
                each publis in publicaciones
                    div(class='relative flex flex-col items-center mb-16 mt-9 mx-auto w-fit')
                        div(class='bg-white/80 backdrop-blur-md rounded-3xl z-20 shadow-xl border border-white/60 flex overflow-hidden w-fit transition-all hover:shadow-2xl')
                            div(class='w-16 shrink-0 flex flex-col items-center py-6 border-r border-gray-200/80 bg-white/40')
                                if publis.Usuario && publis.Usuario.id
                                    a(href=`/user/${publis.Usuario.id}` 
                                    class="vertical-text text-center font-black text-gray-800 hover:text-blue-600 tracking-widest text-xs uppercase transition-colors" 
                                    style="writing-mode: vertical-rl; transform: rotate(180deg);"
                                ) @#{publis.Usuario.username}
                                else 
                                    p(class="vertical-text font-black text-gray-400 tracking-widest text-xs uppercase" style="writing-mode: vertical-rl; transform: rotate(180deg);") @anonimo

                            div(class="bg-slate-950/5 overflow-hidden relative group h-auto w-[50vw]")
                                if publis.imagenes && publis.imagenes.length > 0
                                    div(class="flex transition-transform duration-500 ease-in-out h-full" id=`slider-${publis.id}`)
                                        each image in publis.imagenes
                                            div(class="min-w-full h-full flex items-center justify-center bg-black/5" data-imgid=image.id data-promedio=(image.promedio || '0.0') data-votousuario=image.votoUsuario)
                                                img(src=image.src class="w-auto h-auto object-contain max-w-[50vw] max-h-[70vh]")
                                    if publis.imagenes && publis.imagenes.length > 1
                                        button(class="absolute left-3 top-1/2 -translate-y-1/2 bg-slate-900/40 hover:bg-slate-900/70 backdrop-blur-xs text-white w-9 h-9 flex items-center justify-center rounded-full cursor-pointer opacity-0 group-hover:opacity-100 transition-all z-10 shadow-md" onclick=`cambiarFoto('${publis.id}', -1)`) 
                                            i(class="fa-solid fa-chevron-left text-xs")
                                        button(class="absolute right-3 top-1/2 -translate-y-1/2 bg-slate-900/40 hover:bg-slate-900/70 backdrop-blur-xs text-white w-9 h-9 flex items-center justify-center rounded-full cursor-pointer opacity-0 group-hover:opacity-100 transition-all z-10 shadow-md" onclick=`cambiarFoto('${publis.id}', 1)`) 
                                            i(class="fa-solid fa-chevron-right text-xs")

                            div(class="shrink-0 w-80 p-6 flex flex-col justify-between bg-white/50 border-l border-white/40")
                                div 
                                    h3(class='font-black text-xl text-blue-950 tracking-tight leading-snug drop-shadow-xs')= publis.title
                                    p(class="text-xs text-gray-600 mt-2 leading-relaxed")= publis.description

                                if publis.comments_allowed
                                    p(class='text-xs font-black text-blue-950 uppercase tracking-wider mt-4 mb-2 flex items-center gap-1.5')
                                        i(class="fa-solid fa-comments text-blue-600")
                                        | Comentarios

                                    div(class='max-h-60 overflow-y-auto space-y-2 mb-3 pr-1 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-slate-300 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-blue-400' id=`contenedor-comentarios-${publis.id}`)
                                        if publis.imagenes && publis.imagenes.length > 0
                                            each image, index in publis.imagenes
                                                div(id=`lista-comentarios-${image.id}` class=(index === 0 ? 'block space-y-2' : 'hidden space-y-2'))
                                                    if publis.comentarios && publis.comentarios.length > 0
                                                        each comentario in publis.comentarios
                                                            div(class='p-2.5 bg-white/70 backdrop-blur-xs border border-white/80 rounded-xl shadow-xs flex justify-between items-start gap-2 hover:bg-white/90 transition-all' id=`comentario-${comentario.id}`)
                                                                div(class='flex-1')
                                                                    if comentario.Usuario
                                                                        p(class='text-blue-600 font-bold text-xs') @#{comentario.Usuario.username}
                                                                    else
                                                                        p(class='text-gray-400 italic text-xs') Usuario eliminado
                                                                    span(class='text-xs text-gray-800 font-medium break-words leading-relaxed')= comentario.texto
                                                                
                                                                if usuario && comentario.UsuarioId !== usuario.id
                                                                    button(type="button" class="btn-denunciar-comentario text-gray-400 hover:text-red-500 transition-colors p-1 cursor-pointer" data-id=comentario.id title="Denunciar comentario")
                                                                        i(class="fa-regular fa-flag text-xs")
                                                    else    
                                                        div(class="p-4 bg-white/30 rounded-xl border border-white/40 text-center")
                                                            p(class='text-xs font-bold text-gray-600 sin-comentarios uppercase tracking-wider') Sin comentarios
                                                            p(class='text-xs text-gray-500 mt-0.5') Sé el primero en comentar...
                                    
                                    form.form_comentario(class='flex items-center gap-2')
                                        if publis.imagenes && publis.imagenes.length > 0
                                            input(type="hidden", name="ImagenId" value=publis.imagenes[0].id id=`input-img-${publis.id}`)
                                        else
                                            input(type="hidden", name="ImagenId" value="" id=`input-img-${publis.id}`)
                                        input(type="text" placeholder='Escribí un comentario...' name="texto" required autocomplete="off" class='flex-1 border bg-white/80 rounded-xl px-3 py-2 text-xs font-medium text-gray-800 border-gray-200/80 shadow-inner outline-none focus:border-blue-500 focus:bg-white transition-all')
                                        button(type='submit' class='w-9 h-9 bg-blue-600 hover:bg-blue-500 text-white rounded-xl shadow-md flex items-center justify-center cursor-pointer transition-all active:scale-95 shrink-0') 
                                            i(class="fa-solid fa-arrow-up text-xs")

                                else 
                                    div(class="p-4 bg-white/30 rounded-xl border border-white/40 text-center my-4")
                                        p(class='text-xs font-bold text-gray-500 uppercase tracking-wider') Comentarios desactivados

                                div(class="flex flex-col mt-4 pt-4 border-t border-gray-200/60")
                                    div(class="flex items-center justify-between gap-3")
                                        button(type="button" class='flex-1 bg-blue-600 hover:bg-blue-700 text-white font-black text-xs py-2 px-3 rounded-xl shadow-md transition-all active:scale-95 uppercase tracking-wider' ) Me interesa
                                        div(class="flex items-center gap-3 text-lg")
                                            button(class="group text-red-500 hover:text-red-600 transition-transform active:scale-90 cursor-pointer p-1") 
                                                i(class="fa-regular fa-heart group-hover:hidden")
                                                i(class="fa-solid fa-heart hidden group-hover:inline")
                                            button(type="button"  class="btn-guardar-coleccion text-blue-500 hover:text-blue-600 transition-transform active:scale-90 cursor-pointer p-1.5" data-publi-id=publis.id title="Guardar en colección")
                                                i(class="fa-regular fa-bookmark text-base")

                        if publis.imagenes && publis.imagenes.length > 0
                            div(class="bg-white/80 backdrop-blur-md p-3 pt-7 -mt-5 rounded-b-2xl shadow-lg w-max px-6 text-center border border-white/60 relative z-10 transition-all hover:translate-y-0.5 hover:shadow-xl")
                                div.valoracion(id="caja-estrellas-"+publis.id class="flex items-center justify-center gap-1.5" data-id=publis.imagenes[0].id data-elegido="0")
                                    each num in [1, 2, 3, 4, 5]
                                        if num <= publis.imagenes[0].votoUsuario
                                            i.fa-solid.fa-star(class="text-amber-400 cursor-pointer text-base transition-transform hover:scale-110" data-valor=num onclick=`enviarValoracion('${publis.imagenes[0].id}',${num}, '${publis.id}')`) 
                                        else    
                                            i.fa-regular.fa-star(class="text-amber-400 cursor-pointer text-base transition-transform hover:scale-110" data-valor=num onclick=`enviarValoracion('${publis.imagenes[0].id}', ${num}, '${publis.id}')`)    

                                    span(id="promedio-"+publis.imagenes[0].id class="text-xs font-black text-blue-950 ml-2 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-full shadow-inner promedio-span") #{publis.imagenes[0].promedio || '0.0'}

        div#modal-denuncia-comentario(class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center z-50 p-4")
            div(class="bg-white/95 backdrop-blur-md border border-white/70 p-6 rounded-3xl max-w-md w-full shadow-2xl")
                h4(class="text-lg font-black text-blue-950 mb-4 flex items-center gap-2")
                    i(class="fa-solid fa-shield-halved text-red-600")
                    | Denunciar Comentario
                form#form-denunciar-comentario(class="flex flex-col gap-4")
                    input#input-denuncia-comentario-id(type="hidden")
                    div
                        label(class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5") Motivo de la denuncia:
                        select#select-motivo-denuncia(required class="w-full p-2.5 rounded-xl bg-white border border-gray-200 text-xs font-semibold text-gray-800 outline-none focus:border-blue-500 shadow-xs")
                            option(value="") Seleccioná un motivo
                            option(value="Lenguaje ofensivo") Lenguaje ofensivo
                            option(value="Spam") Spam o publicidad
                            option(value="Acoso") Acoso o intimidación
                            option(value="Contenido inapropiado") Contenido inapropiado
                            option(value="Otro") Otro
                    div
                        label(class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5") Justificación adicional (opcional):
                        textarea#textarea-desc-denuncia(class="w-full p-2.5 rounded-xl bg-white border border-gray-200 text-xs font-medium text-gray-800 outline-none focus:border-blue-500 h-20 shadow-xs resize-none" placeholder="Explicá brevemente el motivo...")
                    div(class="flex justify-end gap-2 mt-2")
                        button#btn-cancelar-modal-comentario(type="button" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl text-xs uppercase tracking-wider transition-all cursor-pointer") Cancelar
                        button(type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer") Enviar denuncia