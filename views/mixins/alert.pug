mixin alert(alert=undefined)
  if alert
    case alert.status
      when "error"
        div.alert.error(class='bg-red-600/50 text-white absolute rounded-sm p-4 border-red-500 font-bold')
          p(class='text-center')= alert.text
      when "success"
      default
        div.alert.success(class='bg-green-600/50 text-white absolute rounded-b-xl p-4 border-green-500 border-b border-r border-l font-bold left-1/2 -translate-x-1/2 ')
          p(class='text-center')= alert.text