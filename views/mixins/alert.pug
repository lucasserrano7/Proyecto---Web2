mixin alert(alert=undefined)
  div#contenedor-alertas(class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-3 w-full max-w-sm pointer-events-none px-4")
    if alert
      - const tipos = { error: { badge: 'bg-red-500 text-white shadow-md shadow-red-500/40', icon: 'fa-triangle-exclamation', titulo: 'Atención' }, success: { badge: 'bg-emerald-500 text-white shadow-md shadow-emerald-500/40', icon: 'fa-circle-check', titulo: 'Completado' }, warning: { badge: 'bg-amber-500 text-white shadow-md shadow-amber-500/40', icon: 'fa-circle-exclamation', titulo: 'Aviso' } }
      - const actual = tipos[alert.status] || tipos.success
      div(class="toast-alerta pointer-events-auto flex items-center gap-3.5 p-3.5 px-4 rounded-2xl bg-white/20 backdrop-blur-xl border border-white/50 shadow-[0_12px_32px_rgba(0,0,0,0.25)] transition-all duration-300 translate-y-0 opacity-100 scale-100")
        div(class=`w-9 h-9 rounded-xl flex items-center justify-center shrink-0 ${actual.badge}`)
          i(class=`fa-solid ${actual.icon} text-sm`)
        div(class="flex-1 min-w-0")
          p(class="text-[10px] font-black uppercase tracking-wider text-white/70 leading-none mb-1")= actual.titulo
          p(class="text-xs font-semibold text-white leading-snug drop-shadow-sm")= alert.text
        button(type="button" onclick="this.parentElement.remove()" class="cursor-pointer text-white/50 hover:text-white transition-colors p-1 shrink-0")
          i(class="fa-solid fa-xmark text-xs")