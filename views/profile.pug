extends layout 

block metadata
  script(src="/seguidorses.js" defer)
  script(src="/editarPerfil.js" defer)
  script(src="https://cdn.tailwindcss.com")

include mixins/publicaciones.pug

block contenido 
  div(class='max-w-7xl mx-auto flex flex-col sm:flex-row rounded-b-2xl bg-blue-700/30 backdrop-blur-lg border-b border-r border-l border-white/30 shadow-lg text-white items-center justify-between px-8 py-5 gap-4')
    
    div(class='flex items-center gap-4 flex-wrap')
      div(class="w-14 h-14 rounded-2xl overflow-hidden bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white font-black text-2xl shadow-inner shrink-0")
        if fotoPerfilSrc || (usuarioPerfil && (usuarioPerfil.avatar || usuarioPerfil.foto))
          img(src=(fotoPerfilSrc || usuarioPerfil.avatar || usuarioPerfil.foto) alt=usuarioPerfil.username class="w-full h-full object-cover")
        else if usuarioPerfil && usuarioPerfil.username
          span= usuarioPerfil.username.charAt(0).toUpperCase()
        else
          i(class="fa-solid fa-user text-lg text-white/80")

      h2(class='text-3xl font-black tracking-tight drop-shadow-sm') @#{usuarioPerfil.username}
      
      div(class='flex items-center gap-2 ml-2')
        div(class='flex items-center gap-2 bg-white/30 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-white/50 shadow-sm')
          span#contador-seguidores(class='text-lg font-black text-white') #{constSeguidores || 0}
          span(class='text-[10px] font-bold uppercase tracking-wider text-white/90') Seguidores

        div(class='flex items-center gap-2 bg-white/30 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-white/50 shadow-sm')
          span(class='text-lg font-black text-white') #{constSeguidos || 0}
          span(class='text-[10px] font-bold uppercase tracking-wider text-white/90') Siguiendo

    div 
      if usuario && usuarioPerfil && usuario.id !== usuarioPerfil.id
        if yaLoSigo
          button(
            type="button" 
            class='seguir-btn bg-emerald-500/80 hover:bg-emerald-600 border border-white/50 text-white font-bold py-2 px-5 rounded-2xl transition-all shadow-md active:scale-95 cursor-pointer text-sm flex items-center gap-2' 
            data-creator-id=usuarioPerfil.id
          )
            i(class="fa-solid fa-user-check text-xs")
            span Siguiendo
        else
          button(
            type="button" 
            class='seguir-btn bg-white/20 hover:bg-white/30 border border-white/40 text-white font-bold py-2 px-5 rounded-2xl transition-all shadow-md active:scale-95 cursor-pointer text-sm flex items-center gap-2' 
            data-creator-id=usuarioPerfil.id
          )
            i(class="fa-solid fa-user-plus text-xs")
            span Seguir

      else if usuario && usuarioPerfil && usuario.id === usuarioPerfil.id
        div(class="flex items-center gap-2")
          button#btn-abrir-editar(
            type="button" 
            class="bg-white/20 hover:bg-white/30 border border-white/40 text-white font-bold py-2 px-4 rounded-2xl transition-all shadow-md flex items-center gap-2 text-xs sm:text-sm cursor-pointer active:scale-95"
          )
            i(class="fa-solid fa-pen-to-square text-xs")
            span Editar Perfil
          a(
            href="/logout" 
            class="bg-red-500/70 hover:bg-red-600 border border-white/30 text-white font-bold py-2 px-4 rounded-2xl transition-all shadow-md flex items-center gap-2 text-xs sm:text-sm cursor-pointer active:scale-95"
          ) 
            i(class='fa-solid fa-right-from-bracket text-xs')
            span Cerrar Sesión

  if esMiPerfil
    div#modal-editar-perfil(class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center z-50 p-4")
      div(class="bg-white/95 backdrop-blur-md border border-white/70 p-6 rounded-3xl max-w-md w-full shadow-2xl animate-fade-in")
        h4(class="text-lg font-black text-blue-950 mb-4 flex items-center gap-2")
          i(class="fa-solid fa-user-pen text-blue-600")
          | Editar Información
        
        form#form-editar-perfil(class="flex flex-col gap-4")
          div(class="flex flex-col items-center gap-2")
            div(class="w-20 h-20 rounded-2xl overflow-hidden bg-blue-100/60 border-2 border-dashed border-blue-400/80 flex items-center justify-center shadow-inner relative group")
              if fotoPerfilSrc
                img#preview-avatar(src=fotoPerfilSrc class="w-full h-full object-cover")
              else
                div#preview-placeholder(class="text-blue-600 text-2xl font-black")= usuarioPerfil.username.charAt(0).toUpperCase()
                img#preview-avatar(src="" class="w-full h-full object-cover hidden")
            
            label(for="input-avatar" class="cursor-pointer text-xs font-black text-blue-600 hover:text-blue-700 uppercase tracking-wider flex items-center gap-1.5 mt-1")
              i(class="fa-solid fa-camera text-xs")
              span Cambiar foto
            input#input-avatar(type="file" name="avatar" accept="image/*" class="hidden")

          div
            label(class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5") Nombre de usuario
            input#input-username(type="text" name="username" value=usuarioPerfil.username required class="w-full p-2.5 rounded-xl bg-white border border-gray-200 text-xs font-semibold text-gray-800 outline-none focus:border-blue-500 shadow-xs")

          div(class="flex justify-end gap-2 mt-2")
            button#btn-cerrar-editar(type="button" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl text-xs uppercase tracking-wider transition-all cursor-pointer") Cancelar
            button(type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer") Guardar Cambios

  if publicaciones && publicaciones.length > 0
    div(class="mt-6")
      +publicaciones(usuario)
  else
    div(class="bg-white/10 backdrop-blur-md rounded-3xl border border-white/30 p-12 text-center max-w-md mx-auto shadow-xl text-white mt-12")
      h3(class="text-lg font-bold mb-1") Sin publicaciones aún
      p(class="text-xs text-white/70 font-medium") Este usuario todavía no compartió ninguna foto.