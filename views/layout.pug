doctype html
html(lang='es')
  head
    meta(charset="UTF-8")
    title Proyecto Web 2 | Lucas Serrano
    script(src="https://kit.fontawesome.com/65094b592d.js" crossorigin="anonymous")
    script(src="https://cdn.tailwindcss.com")
    script(src="/main.js" defer) 
    script(src="/guardarColeccion.js" defer)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_circle_up")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=visibility")
    block metadata
    style. 
      body {
        background-image: url('/img/WinHS (1).jpg');
        background-size: cover;
        background-position: center;          
        background-attachment: fixed;
        background-repeat: no-repeat;
      }

  include mixins/navbar.pug
  include mixins/alert.pug

  body(class="min-h-screen flex flex-col bg-linear-to-br from-[#1e4eb8] via-[#4a90e2] to-[#b3d9ff] bg-fixed")
    block navbar      
      +navbar(usuario)
      +alert(alert)

    main(class='grow')
      block contenido 

    div#modal-guardar-coleccion(class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center z-50 p-4")
      div(class="bg-white/90 backdrop-blur-lg border border-white/70 p-6 rounded-3xl max-w-sm w-full shadow-2xl flex flex-col transition-all")
        div(class="flex items-center justify-between pb-3 border-b border-gray-200/80 mb-3")
          div
            h4(class="text-base font-black text-blue-950 flex items-center gap-2")
              i(class="fa-solid fa-bookmark text-blue-600")
              | Guardar en Colección
            p(class="text-[11px] text-gray-500 font-medium") Elegí en qué álbum querés incluir esta foto.
          button#btn-cerrar-modal-guardar(type="button" class="text-gray-400 hover:text-gray-700 text-lg cursor-pointer p-1 transition-colors")
            i(class="fa-solid fa-xmark")

        div#lista-colecciones-guardar(class="flex flex-col gap-2 max-h-60 overflow-y-auto pr-1 my-2")

        div(class="pt-3 border-t border-gray-200/80 flex items-center justify-between mt-2")
          a(href="/colecciones" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1.5 transition-colors")
            i(class="fa-solid fa-folder-plus text-xs")
            | Crear nueva
          button#btn-listo-modal-guardar(type="button" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer")
            | Listo

    block footer     
      footer(class='bg-white/5 backdrop-blur-md border-b shadow-lg text-white text-center items-center p-4')
        p © Lucas Serrano