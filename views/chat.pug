extends layout

block contenido
  div(style="max-width: 1100px; margin: 25px auto; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); overflow: hidden; display: flex; height: 75vh; border: 1px solid #e5e7eb; font-family: sans-serif;")
    div(style="width: 320px; border-right: 1px solid #e5e7eb; display: flex; flex-direction: column; background: #f9fafb;")
      div(style="padding: 16px; border-bottom: 1px solid #e5e7eb; background: #ffffff;")
        h2(style="margin: 0; font-size: 18px; font-weight: bold; color: #1f2937;") Mensajes
      div(style="flex: 1; overflow-y: auto;")
        if conversaciones && conversaciones.length > 0
          each c in conversaciones
            - const activo = c.id === conversacionId
            a(href=`/me-interesa/chat/${c.id}` style=`display: flex; align-items: center; gap: 12px; padding: 12px 16px; text-decoration: none; border-bottom: 1px solid #f3f4f6; transition: background 0.2s; background: ${activo ? '#e0e7ff' : 'transparent'};`)
              if c.miniatura
                img(src=c.miniatura alt="Foto" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; flex-shrink: 0;")
              else
                div(style="width: 48px; height: 48px; background: #cbd5e1; border-radius: 8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #475569;") Sin foto
              div(style="overflow: hidden; flex: 1;")
                p(style=`margin: 0; font-size: 14px; font-weight: ${activo ? '700' : '600'}; color: #1e293b; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;`)= `@${c.otroUsername}`
                p(style="margin: 2px 0 0 0; font-size: 12px; color: #64748b; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;")= c.tituloPublicacion
        else
          p(style="padding: 20px; color: #94a3b8; font-size: 14px; text-align: center;") No hay otras conversaciones.

    div(style="flex: 1; display: flex; flex-direction: column; background: #ffffff;")
      div(style="padding: 14px 20px; border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; background: #ffffff;")
        div(style="display: flex; align-items: center; gap: 12px;")
          if otroUsuario.foto
            img(src=otroUsuario.foto alt="Perfil" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;")
          div
            h3(style="margin: 0; font-size: 16px; color: #111827; font-weight: bold;")= `@${otroUsuario.username}`
            p(style="margin: 0; font-size: 12px; color: #6b7280;")= `Interés en: ${publicacion.title}`
        a(href=`/p/${publicacion.id}` target="_blank" style="font-size: 13px; color: #2563eb; text-decoration: none; font-weight: 500;") Ver publicación ↗

      div#chat-box(style="flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 10px; background: #f8fafc;")
        each m in mensajes
          div(style=`display: flex; justify-content: ${m.esMio ? 'flex-end' : 'flex-start'};`)
            div(style=`max-width: 70%; padding: 10px 14px; border-radius: 12px; font-size: 14px; line-height: 1.4; word-break: break-word; background: ${m.esMio ? '#2563eb' : '#ffffff'}; color: ${m.esMio ? '#ffffff' : '#1e293b'}; border: ${m.esMio ? 'none' : '1px solid #e2e8f0'}; box-shadow: 0 1px 2px rgba(0,0,0,0.05);`)
              span= m.texto

      form#form-msg(style="padding: 14px 20px; border-top: 1px solid #e5e7eb; display: flex; gap: 10px; background: #ffffff;")
        input#input-texto(type="text" placeholder="Escribí un mensaje..." required autocomplete="off" style="flex: 1; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; outline: none; font-size: 14px;")
        button(type="submit" style="background: #2563eb; color: #ffffff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s;") Enviar

  script.
    const form = document.getElementById("form-msg");
    const input = document.getElementById("input-texto");
    const chatBox = document.getElementById("chat-box");
    chatBox.scrollTop = chatBox.scrollHeight;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const texto = input.value.trim();
      if (!texto) return;

      const res = await fetch("/me-interesa/chat/#{conversacionId}/enviar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ texto })
      });
      
      const data = await res.json();
      if (data.success) {
        const wrap = document.createElement("div");
        wrap.style.display = "flex";
        wrap.style.justifyContent = "flex-end";
        
        const bubble = document.createElement("div");
        bubble.style.maxWidth = "70%";
        bubble.style.padding = "10px 14px";
        bubble.style.borderRadius = "12px";
        bubble.style.fontSize = "14px";
        bubble.style.lineHeight = "1.4";
        bubble.style.wordBreak = "break-word";
        bubble.style.background = "#2563eb";
        bubble.style.color = "#ffffff";
        bubble.style.boxShadow = "0 1px 2px rgba(0,0,0,0.05)";
        bubble.innerText = data.mensaje.texto;
        
        wrap.appendChild(bubble);
        chatBox.appendChild(wrap);
        chatBox.scrollTop = chatBox.scrollHeight;
        input.value = "";
      }
    });