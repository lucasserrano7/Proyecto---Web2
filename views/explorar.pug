extend layout 

block metadata 
        title Explorar
        script(src="https://cdn.tailwindcss.com")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_circle_up")
include mixins/publicaciones.pug
block contenido

        main(class='mx-auto p-4 flex flex-col items-center')
                form(action="/explorar" method="GET" class="flex items-center gap-2 bg-black/20 p-2 rounded-full border border-white/30 backdrop-blur-sm ")
                        input(type="text" name="keyword" placeholder="Buscar en publicaciones..." class="bg-transparent border-none outline-none text-white px-3 w-full text-xl")
                        button(type="submit" class="text-white hover:text-blue-300 cursor-pointer px-2") 
                                i(class="fa-solid fa-magnifying-glass")

        block publicaciones      
        +publicaciones(usuario)

                if etiquetasGuardadas && etiquetasGuardadas.length > 0
                        div(class="flex flex-wrap gap-2 mt-2")
                                p(class="text-xs text-white/70 w-full font-semibold") Filtrar por etiquetas:
                                        each tag in etiquetasGuardadas
                                                a(href=`/explorar?tag=${tag.nombre}` class="text-xs font-semibold text-blue-100 bg-blue-600/40 px-3 py-1.5 rounded-full hover:bg-blue-500 cursor-pointer transition-colors border border-blue-400/30 drop-shadow-md") 
                                                | ##{tag.nombre}
                        div(class="mb-8 text-center mt-6")
                                if palabraBuscada
                                        h2(class='text-sm text-blue-900 font-bold drop-shadow-md bg-white/40 px-6 py-2 rounded-full inline-block') Resultados para: "#{palabraBuscada}"
                                else
                                        h2(class='text-sm text-blue-900 font-bold drop-shadow-md bg-white/40 px-6 py-2 rounded-full inline-block') Explorando todas las publicaciones
                else
                        div(class="bg-white/20 p-10 rounded-3xl text-center shadow-lg mt-10 border-white border")
                                p(class='text-white text-2xl font-semibold ') No se encontraron publicaciones que coincidan con la busqueda.
                                p(class='text-white/80 mt-2') Probá buscando con otras palabras.


